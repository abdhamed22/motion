  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "id": "c1",
       "leftValue": "={{ $json.body.website }}",
       "rightValue": "",
       "operator": {
        "type": "string",
        "operation": "empty",
        "singleValue": true
       }
      },
      {
       "id": "c2",
       "leftValue": "={{ $json.body.message }}",
       "rightValue": "",
       "operator": {
        "type": "string",
        "operation": "notEmpty",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    }
   },
   "id": "n2",
   "name": "ليس سبام؟",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    260,
    200
   ]
  },
  {
   "parameters": {
    "chatId": "PUT_YOUR_TELEGRAM_CHAT_ID",
    "text": "=📩 رسالة جديدة\nرقم: {{ $json.body.ticket }}\nالاسم: {{ $json.body.name }}\nللرد: {{ $json.body.contact }}\nالموضوع: {{ $json.body.topic }}\n\n{{ $json.body.message }}",
    "additionalFields": {
     "appendAttribution": false
    }
   },
   "id": "n3",
   "name": "تنبيه تيليغرام",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    520,
    100
   ]
  },
  {
   "parameters": {
    "respondWith": "json",
